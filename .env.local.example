# ============================================================================
# APPWRITE CONFIGURATION
# ============================================================================

# Your Appwrite instance endpoint
# For Appwrite Cloud: https://cloud.appwrite.io
# For self-hosted: https://your-appwrite-instance.com
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io

# Your Appwrite Project ID
# Get this from: Appwrite Console > Settings > Project ID
VITE_APPWRITE_PROJECT_ID=your_project_id_here

# Your Appwrite Database ID
# Default: devices (will be auto-created by bash.sh)
VITE_APPWRITE_DATABASE_ID=devices

# Your Appwrite Devices Collection ID
# Default: registered_devices (will be auto-created by bash.sh)
VITE_APPWRITE_DEVICES_COLLECTION_ID=registered_devices
VITE_APPWRITE_POWERBANKS_COLLECTION_ID=power_banks
VITE_APPWRITE_RENTALS_COLLECTION_ID=power_bank_rentals

# ============================================================================
# APPWRITE SETUP (Used by bash.sh script)
# ============================================================================

# Appwrite API Key with databases.write scope
# Get this from: Appwrite Console > Settings > API Keys
# Create one with these scopes:
#   - databases.read
#   - databases.write
#   - collections.read
#   - collections.write
#   - attributes.read
#   - attributes.write
#   - documents.read
#   - documents.write
APPWRITE_API_KEY=your_api_key_here

# These are optional if you want to use different database/collection names
# APPWRITE_DATABASE_ID=your_database_id
# APPWRITE_COLLECTION_ID=your_collection_id

# ============================================================================
# SUPABASE CONFIGURATION (Optional - if using Supabase instead)
# ============================================================================

# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your_anon_key_here

# ============================================================================
# HOW TO SETUP
# ============================================================================
# 1. Copy this file to .env.local
# 2. Fill in your Appwrite credentials
# 3. Run: bash ./bash.sh
# 4. The script will automatically create the database, collections, and attributes
# 5. Run: npm run dev
